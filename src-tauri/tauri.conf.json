{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DualLink",
  "version": "1.0.0",
  "identifier": "com.endymi0n74.duallink",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "DualLink",
        "width": 960,
        "height": 720,
        "minWidth": 780,
        "minHeight": 580,
        "center": true,
        "decorations": true,
        "transparent": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}