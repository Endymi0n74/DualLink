{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DualLink",
  "version": "1.0.0",
  "identifier": "com.endymi0n74.duallink",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "DualLink",
        "width": 900,
        "height": 620,
        "minWidth": 700,
        "minHeight": 500,
        "center": true,
        "decorations": true,
        "transparent": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
